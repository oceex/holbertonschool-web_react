{
  "compilerOptions": {
    "allowJs": true,
    "target": "es5",
    "lib": ["dom", "es2015"],
    "types": [],
    "module": "es2015",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "strict": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  "include": ["js/**/*"],
  "exclude": ["node_modules"]
}